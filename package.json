{
  "name": "folio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "turbo typecheck",
    "format": "biome format --write",
    "format:check": "biome format",
    "db:generate": "pnpm --filter @folio/db generate",
    "db:migrate": "pnpm --filter @folio/db migrate",
    "db:studio": "pnpm --filter @folio/db studio",
    "dev:web": "pnpm --filter @folio/web dev",
    "dev:api": "pnpm --filter @folio/server dev",
    "deploy:dev": "pnpm --filter @folio/server deploy:dev",
    "deploy:prod": "pnpm --filter @folio/server deploy:prod",
    "dev:desktop": "pnpm --filter @folio/desktop dev",
    "dev:mobile": "pnpm --filter @folio/mobile dev",
    "dev:extension": "pnpm --filter @folio/extension dev"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "turbo": "^2.0.0",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  }
}
