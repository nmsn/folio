{
  "name": "@folio/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "alchemy dev",
    "build": "alchemy deploy --dry-run",
    "deploy:dev": "alchemy deploy --stage dev",
    "deploy:prod": "alchemy deploy --stage prod",
    "destroy:dev": "alchemy destroy --stage dev",
    "destroy:prod": "alchemy destroy --stage prod",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@folio/api": "workspace:*",
    "@folio/db": "workspace:*",
    "@mozilla/readability": "^0.6.0",
    "@orpc/server": "catalog:",
    "drizzle-orm": "catalog:",
    "fast-xml-parser": "^5.0.0",
    "hono": "catalog:",
    "linkedom": "^0.18.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@folio/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "alchemy": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
